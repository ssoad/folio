# Copy to folio.env and fill in. docker compose reads it automatically.
# Full reference: httpserver/README.md

# Port the web app and server are published on
# FOLIO_PORT=80

# ── Accounts and admin panel ────────────────────────────────────────────────
# Address people reach the server at (needed for Google sign-in, cloud
# drives and email links), e.g. https://folio.example.com
PRO_PUBLIC_URL=
# First admin for /admin. Leave empty to use the setup code from the log.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Encrypts saved data-source credentials: openssl rand -hex 32
PRO_TOKEN_KEY=
# Optional owner token with every feature and no limits (16+ characters)
PRO_ACCESS_TOKEN=
# Extra browser origins allowed to call the server, comma-separated
ALLOWED_ORIGINS=

# ── AI (any OpenAI-compatible API) ──────────────────────────────────────────
# OpenRouter: https://openrouter.ai/api/v1   Ollama profile: http://ollama:11434/v1
PRO_AI_BASE_URL=
PRO_AI_API_KEY=
PRO_AI_MODEL=
# Optional vision model for OCR, defaults to PRO_AI_MODEL
PRO_OCR_MODEL=

# ── Voices ──────────────────────────────────────────────────────────────────
# Kokoro profile: http://kokoro:8880/v1
PRO_TTS_BASE_URL=
PRO_TTS_API_KEY=
PRO_TTS_MODEL=kokoro
PRO_TTS_VOICE=af_heart

# ── Cloud drives (redirect URI: <PRO_PUBLIC_URL>/pro/v1/oauth/callback) ─────
PRO_OAUTH_GOOGLE_CLIENT_ID=
PRO_OAUTH_GOOGLE_CLIENT_SECRET=
PRO_OAUTH_GOOGLE_APP_ID=
PRO_OAUTH_GOOGLE_API_KEY=
PRO_OAUTH_MICROSOFT_CLIENT_ID=
PRO_OAUTH_MICROSOFT_CLIENT_SECRET=
PRO_OAUTH_DROPBOX_CLIENT_ID=
PRO_OAUTH_DROPBOX_CLIENT_SECRET=

# ── File server, OPDS and KOReader sync (off by default) ────────────────────
ENABLE_HTTP_SERVER=false
SERVER_USERNAME=admin
# Required when ENABLE_HTTP_SERVER=true
SERVER_PASSWORD=
ENABLE_OPDS=false
ENABLE_KOREADER_SERVER=false
